# Secrets — NEVER commit
.env
.env.*
!.env.example
*.key
*.pem
valorant*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual envs
.venv/
venv/
env/
ENV/

# Generated / large
data/*.json
data/*.csv
data/*.parquet
data/*.db
data/*.sqlite
models/*
logs/
!data/.gitkeep
!models/.gitkeep
!logs/.gitkeep

# Half-win-rates is salvaged input — keep it
!data/half_win_rates.json

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# uv
.uv/

# Generated DP table + round events (Phase 1 / Phase 2 outputs)
models/dp_table.pkl
data/round_events*
data/round_events.sqlite

# Calibrated round-conclusion lookup is a committed artifact (D-15 — diff-friendly,
# reviewable in PRs). Exception to the blanket models/ rule above.
!models/round_conclusion.json

# Tooling caches not yet covered above
.tox/
.nox/
scripts/_probe_live.log
scripts/_probe_live.err

# Phase 3 generated artifacts (large; per-machine).
# Use file-globs (not bare directory paths) so .gitkeep markers below remain
# tracked — Git can re-include unignored files only when the parent directory
# is itself unignored. See git-scm "Two consequences" caveat under PATTERN FORMAT.
data/ribgg_cache/*
data/event_log/*
data/metrics/*
data/round_events_v2*

# .gitkeep markers for the otherwise-gitignored Phase 3 artifact directories,
# so the directory layout is reproducible on a fresh clone (03-07 D-08).
!data/ribgg_cache/.gitkeep
!data/event_log/.gitkeep
!data/metrics/.gitkeep

# Phase 4 — hypothetical-fill ledgers (per-strategy JSONL files; per-machine).
# Same glob-then-allow-list pattern as Phase 3 above (Git PATTERN FORMAT
# "two consequences" caveat — bare `data/fills/` blocks `!.gitkeep`).
data/fills/*
!data/fills/.gitkeep

# Autonomous-loop scratch output (operator harness; per-machine)
.claude-loop-output.tmp
